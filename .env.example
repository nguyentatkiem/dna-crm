# Database. Mặc định SQLite (một file trên máy). Khi chạy trên internet: dùng Postgres, xem README.
DATABASE_URL="file:./dev.db"

# Chuỗi bí mật để ký phiên đăng nhập. HÃY ĐỔI thành chuỗi ngẫu nhiên dài (openssl rand -base64 32).
SESSION_SECRET="doi-chuoi-nay-thanh-chuoi-bi-mat-dai-it-nhat-32-ky-tu"

# Không bắt buộc. Có key thì các AI Agent dùng Claude; để trống thì chạy bằng template và luật.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"

# Không bắt buộc. Chép lời ghi âm cuộc gọi tiếng Việt để AI chấm điểm. Chọn MỘT trong hai:
# 1) Máy chủ chuẩn OpenAI /v1/audio/transcriptions chạy trên máy bạn (speaches + faster-whisper, whisper.cpp server...)
TRANSCRIBE_BASE_URL=""
TRANSCRIBE_MODEL="Systran/faster-whisper-large-v3"
TRANSCRIBE_API_KEY=""
# 2) FPT.AI Speech to Text (trả phí theo phút)
FPT_AI_API_KEY=""

# Địa chỉ công khai của CRM khi chạy thật (vd https://crm.congty.vn). Dùng cho link báo giá, khảo sát,
# ngừng nhận tin và theo dõi email. Để trống thì lấy theo địa chỉ đang mở.
APP_URL=""

# ---- Thông báo đẩy lên điện thoại (không bắt buộc) ----
# Tạo khoá: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ban@congty.vn"
# 1 = bật service worker cả khi chạy npm run dev (mặc định chỉ bật ở bản build).
NEXT_PUBLIC_PWA_DEV=""

# ---- Sao lưu (không bắt buộc) ----
# Thư mục chứa bản sao lưu. Mặc định ./backups (Docker: /app/backups).
BACKUP_DIR=""
# Số bản sao lưu TOÀN HỆ THỐNG giữ lại (mỗi ngày một bản). Bản của từng workspace chỉnh ở Cài đặt → Sao lưu.
BACKUP_KEEP="14"
# Đặt 0 để tắt sao lưu toàn hệ thống hằng ngày (vẫn giữ sao lưu từng workspace).
BACKUP_SYSTEM=""
# Đặt off để tắt mọi việc chạy nền (sao lưu, nhắc việc, kịch bản chăm sóc...).
CRM_JOBS=""

# ---- Chỉ dùng khi chạy bằng Docker (docker-compose.yml đọc file .env này) ----
# Cổng mở ra ngoài máy.
CRM_PORT="3210"
# 1 = tạo tài khoản demo ở lần chạy đầu.
CRM_DEMO="0"
# Bật chép lời bằng speaches trong Docker: docker compose --profile stt up -d, rồi đặt:
# CRM_TRANSCRIBE_URL="http://speaches:8000"
# Postgres trong Docker: xem docker/postgres.env.example
# DB_PROVIDER="postgresql"
# CRM_DATABASE_URL="postgresql://crm:doi-mat-khau-nay@postgres:5432/crm?schema=public"
