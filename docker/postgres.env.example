# Chép các dòng này vào file .env (cạnh docker-compose.yml) để chạy CRM với Postgres trong Docker.
# Rồi: docker compose up -d --build
COMPOSE_PROFILES=postgres
DB_PROVIDER=postgresql
POSTGRES_PASSWORD=doi-mat-khau-nay
CRM_DATABASE_URL=postgresql://crm:doi-mat-khau-nay@postgres:5432/crm?schema=public
