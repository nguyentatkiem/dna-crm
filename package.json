{
  "name": "dna-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "setup": "tsx scripts/setup.ts && prisma db push",
    "demo": "tsx scripts/demo.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "db:postgres": "tsx scripts/use-db.ts postgres",
    "db:sqlite": "tsx scripts/use-db.ts sqlite",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f crm",
    "docker:backup": "docker compose exec crm npm run backup"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@formulajs/formulajs": "4.6.1",
    "@prisma/client": "6.19.3",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/pm": "3.32.3",
    "@tiptap/react": "3.32.3",
    "@tiptap/starter-kit": "3.32.3",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "jose": "5.10.0",
    "jssip": "3.13.9",
    "next": "15.5.28",
    "nodemailer": "10.3.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.10.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "5.1.0"
  }
}
