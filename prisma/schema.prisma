// SQLite cho phát triển. Khi lên Postgres/Supabase: đổi provider = "postgresql".
// Các cột *Json lưu chuỗi JSON để chạy được trên cả hai.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  // Bảo mật đăng nhập: TOTP 2 lớp (secret mã hoá bằng AUTH_SECRET), khoá tạm khi sai nhiều lần.
  totpSecret   String        @default("")
  totpEnabled  Boolean       @default(false)
  recoveryJson String        @default("[]") // mã khôi phục đã băm
  failedLogins Int           @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime      @default(now())
  memberships  Membership[]
  sessions     UserSession[]
}

// Phiên đăng nhập: JWT mang sid; requireApp kiểm tra phiên chưa bị thu hồi.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  ip         String    @default("")
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Nhật ký lỗi máy chủ (gộp theo dấu vân tay), để chủ biết khi app gặp lỗi.
model ErrorLog {
  id          String   @id @default(cuid())
  workspaceId String   @default("")
  fingerprint String
  level       String   @default("error")
  message     String
  stack       String   @default("")
  path        String   @default("")
  count       Int      @default(1)
  firstAt     DateTime @default(now())
  lastAt      DateTime @default(now())
  resolved    Boolean  @default(false)

  @@unique([fingerprint])
  @@index([lastAt])
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  industry      String            @default("")
  onboarded     Boolean           @default(false)
  formKey       String            @unique @default(cuid())
  hookKey       String?           @unique
  settingsJson  String            @default("{}")
  createdAt     DateTime          @default(now())
  memberships   Membership[]
  dnas          Dna[]
  configs       WorkspaceConfig[]
  records       Record[]
  tasks         Task[]
  automations   Automation[]
  agents        AgentSetting[]
  logs          AgentLog[]
  invites       Invite[]
  leadEvents    LeadEvent[]
  calls         Call[]
  scorecards    Scorecard[]
  lessons       Lesson[]
  conversations Conversation[]
  adSpends      AdSpend[]
  sequences     Sequence[]
  outMessages   OutMessage[]
  dashboards    Dashboard[]
  docs          Doc[]
  auditLogs     AuditLog[]
  notifications Notification[]
  prefs         Pref[]
  products      Product[]
  quotes        Quote[]
  orders        Order[]
  payments      Payment[]
  contracts     Contract[]
  tickets       Ticket[]
  loyaltyTxns   LoyaltyTxn[]
  warranties    Warranty[]
  segments      Segment[]
  broadcasts    Broadcast[]
  unsubscribes  Unsubscribe[]
  landingPages  LandingPage[]
  kpiTargets    KpiTarget[]
  posts         Post[]
  pushSubs      PushSub[]
  counters      Counter[]
  mergeLogs     MergeLog[]
  surveys       Survey[]
  surveyResps   SurveyResponse[]
  voucherCamps  VoucherCampaign[]
  vouchers      Voucher[]
  teams         Team[]
  perfReviews   PerfReview[]
  boardViews    BoardView[]
  fbPages       FbPage[]
  bankTxns      BankTxn[]
  invoices      EInvoice[]
  shipments     Shipment[]
  kbDocs        KbDoc[]
  stockMoves    StockMove[]
  priceRules    PriceRule[]
  printTpls     PrintTemplate[]
  chatThreads   ChatThread[]
  reports       Report[]
  channelAccts  ChannelAccount[]
  fbPosts       FbPost[]
  quickReplies  QuickReply[]
}

model Membership {
  userId      String
  workspaceId String
  role        String    @default("owner")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model Invite {
  token       String    @id
  workspaceId String
  role        String    @default("member")
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Dna {
  id          String    @id @default(cuid())
  workspaceId String
  dataJson    String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceConfig {
  id          String    @id @default(cuid())
  workspaceId String
  version     Int
  configJson  String
  source      String    @default("template")
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

model Record {
  id          String     @id @default(cuid())
  workspaceId String
  objectKey   String
  title       String
  status      String
  ownerName   String     @default("")
  amount      Float      @default(0)
  score       Int        @default(0)
  winProb     Int?
  dataJson    String     @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // Thùng rác: có giá trị = đã xoá mềm (ẩn khỏi mọi nơi, khôi phục được, tự xoá hẳn sau 30 ngày).
  deletedAt   DateTime?
  deletedBy   String     @default("")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activities  Activity[]

  @@index([workspaceId, objectKey])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, objectKey, updatedAt])
}

model Activity {
  id        String   @id @default(cuid())
  recordId  String
  kind      String   @default("update")
  body      String
  author    String
  createdAt DateTime @default(now())
  record    Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  recordId    String?
  title       String
  assignee    String    @default("")
  dueAt       DateTime?
  done        Boolean   @default(false)
  source      String    @default("Bạn")
  createdAt   DateTime  @default(now())
  // Mục gắn với việc này đang nằm trong thùng rác → ẩn việc cho tới khi khôi phục.
  inTrash     Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dueAt])
}

model Automation {
  id             String    @id @default(cuid())
  workspaceId    String
  triggerType    String
  triggerObject  String
  triggerValue   String    @default("")
  actionType     String
  actionValue    String
  name           String    @default("")
  // Bản mở rộng: nhiều điều kiện và nhiều hành động. Rỗng thì dùng các cột trigger/action cũ.
  conditionsJson String    @default("[]")
  actionsJson    String    @default("[]")
  enabled        Boolean   @default(true)
  runs           Int       @default(0)
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AgentSetting {
  workspaceId String
  agentKey    String
  enabled     Boolean
  autonomy    String    @default("suggest")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, agentKey])
}

model AgentLog {
  id          String    @id @default(cuid())
  workspaceId String
  agent       String
  message     String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Nhật ký mọi lead đổ về từ Ads, Zalo OA, sàn TMĐT, website... để đối soát và chống trùng.
model LeadEvent {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String
  channel     String
  externalId  String    @default("")
  status      String
  message     String    @default("")
  recordId    String?
  payloadJson String    @default("{}")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, provider, externalId])
}

// Một cuộc gọi telesales: kết quả, ghi âm, bản chép lời, điểm AI và điểm quản lý chấm lại.
model Call {
  id               String    @id @default(cuid())
  workspaceId      String
  recordId         String?
  phone            String    @default("")
  direction        String    @default("out")
  agentName        String
  outcome          String
  durationSec      Int       @default(0)
  note             String    @default("")
  callbackAt       DateTime?
  recordingPath    String    @default("")
  recordingUrl     String    @default("")
  provider         String    @default("manual")
  externalId       String    @default("")
  transcript       String    @default("")
  summary          String    @default("")
  aiScore          Int?
  sentiment        Int?
  segmentsJson     String    @default("")
  scoreJson        String    @default("")
  scorecardVersion Int       @default(0)
  reviewScore      Int?
  reviewNote       String    @default("")
  reviewedBy       String    @default("")
  reviewedAt       DateTime?
  startedAt        DateTime  @default(now())
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startedAt])
  @@index([recordId])
}

// Phiếu chấm điểm cuộc gọi + kịch bản gọi, có phiên bản để vòng phản hồi cập nhật.
model Scorecard {
  id           String    @id @default(cuid())
  workspaceId  String
  version      Int
  criteriaJson String
  scriptText   String    @default("")
  source       String    @default("template")
  note         String    @default("")
  isActive     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

// Bài học rút ra từ cuộc gọi thắng/thua: đề xuất sửa phiếu chấm, kịch bản; chủ duyệt mới áp dụng.
model Lesson {
  id           String    @id @default(cuid())
  workspaceId  String
  title        String
  body         String
  proposalJson String    @default("")
  status       String    @default("new")
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Hộp thư hợp nhất: mỗi người nhắn Zalo OA / Facebook Messenger là một hội thoại.
model Conversation {
  id             String    @id @default(cuid())
  workspaceId    String
  channel        String
  externalId     String
  pageId         String    @default("")
  recordId       String?
  name           String    @default("")
  avatar         String    @default("")
  lastText       String    @default("")
  lastAt         DateTime  @default(now())
  unread         Int       @default(0)
  assignee       String    @default("")
  status         String    @default("open")
  tagsJson       String    @default("[]")
  // Pancake-style: inbox | comment (một hội thoại bình luận = một người bình luận trên một bài viết).
  kind           String    @default("inbox")
  postId         String    @default("")
  // Nguồn: "" | post | ad | website | ref (link m.me có tham số) — sourceRef giữ mã bài/ad/ref.
  source         String    @default("")
  sourceRef      String    @default("")
  phones         String    @default("") // các SĐT phát hiện trong tin của khách, cách nhau dấu phẩy
  lastInAt       DateTime?
  lastOutAt      DateTime?
  readAt         DateTime? // nhân viên mở xem lần cuối
  firstReplyAt   DateTime?
  sentiment      String    @default("") // "" | negative | positive
  orderMarked    Boolean   @default(false) // đánh dấu đã/ cần tạo đơn
  privateReplied Boolean   @default(false) // đã nhắn riêng từ bình luận
  quality        Int? // điểm chất lượng chăm sóc 0–100 (AI hoặc luật)
  qualityNote    String    @default("")
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([workspaceId, channel, externalId])
  @@index([workspaceId, lastAt])
  @@index([workspaceId, lastInAt])
  @@index([workspaceId, recordId])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  direction       String
  text            String       @default("")
  attachmentsJson String       @default("[]")
  externalId      String       @default("")
  author          String       @default("")
  status          String       @default("sent")
  error           String       @default("")
  // Bình luận: kind "comment", commentId của nền tảng, parentId = bình luận cha; hidden = đã ẩn trên trang.
  kind            String       @default("message")
  commentId       String       @default("")
  parentId        String       @default("")
  hidden          Boolean      @default(false)
  liked           Boolean      @default(false)
  createdAt       DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Chi phí quảng cáo theo ngày và chiến dịch: kéo từ Facebook/Google Ads hoặc nhập tay, để tính CPL và ROAS.
model AdSpend {
  id          String    @id @default(cuid())
  workspaceId String
  date        DateTime
  provider    String
  accountId   String    @default("")
  campaignId  String
  campaign    String
  spend       Float     @default(0)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  leads       Int       @default(0)
  source      String    @default("manual")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, campaignId, date])
  @@index([workspaceId, date])
}

// Kịch bản chăm sóc tự động: chuỗi tin Zalo/ZNS/SMS/email theo thời gian.
model Sequence {
  id           String       @id @default(cuid())
  workspaceId  String
  name         String
  triggerType  String
  objectKey    String       @default("contacts")
  triggerValue String       @default("")
  stepsJson    String       @default("[]")
  enabled      Boolean      @default(true)
  stopOnReply  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
}

model Enrollment {
  id          String   @id @default(cuid())
  sequenceId  String
  workspaceId String
  recordId    String
  step        Int      @default(0)
  nextAt      DateTime
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sequence    Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, recordId])
  @@index([status, nextAt])
}

// Nhật ký mọi tin gửi ra ngoài (ZNS, SMS, email, Zalo OA, Messenger).
model OutMessage {
  id          String    @id @default(cuid())
  workspaceId String
  recordId    String?
  sequenceId  String?
  broadcastId String?
  channel     String
  to          String
  subject     String    @default("")
  body        String
  status      String
  error       String    @default("")
  provider    String    @default("")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// Dashboard tự chọn widget.
model Dashboard {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  widgetsJson String    @default("[]")
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Tài liệu soạn thảo (Tiptap), có thể gắn vào một khách/giao dịch.
model Doc {
  id          String    @id @default(cuid())
  workspaceId String
  recordId    String?
  title       String
  contentJson String    @default("")
  contentText String    @default("")
  updatedBy   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, recordId])
}

// Nhật ký ai sửa gì.
model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String    @default("")
  userName    String
  action      String
  entity      String
  entityId    String    @default("")
  summary     String
  diffJson    String    @default("")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// Thông báo trong app. userId rỗng = gửi cả workspace.
model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String    @default("")
  kind        String
  text        String
  href        String    @default("")
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
}

// ======================= Nâng cấp theo đối chiếu Getfly (4 đợt) =======================

// Cấu hình không bí mật của workspace, mỗi khoá một JSON: "company" (thông tin in báo giá),
// "loyalty" (tích điểm, hạng), "privacy" (bảo mật dữ liệu), "ticket" (SLA)...
model Pref {
  workspaceId String
  key         String
  valueJson   String    @default("{}")
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
}

// Bộ đếm số chứng từ tự tăng theo năm: key = "BG-2026", "DH-2026", "HD-2026", "TK-2026".
model Counter {
  workspaceId String
  key         String
  value       Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
}

// ---------- Đợt 1: bán hàng ----------
model Product {
  id             String    @id @default(cuid())
  workspaceId    String
  code           String    @default("")
  name           String
  unit           String    @default("cái")
  category       String    @default("")
  price          Float     @default(0)
  vat            Float     @default(0) // %
  warrantyMonths Int       @default(0)
  description    String    @default("")
  // Tồn kho đơn giản
  trackStock     Boolean   @default(false)
  stock          Float     @default(0)
  lowStock       Float     @default(0)
  sku            String    @default("")
  weightGram     Int       @default(0) // cho tính phí vận chuyển
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
}

// Dòng hàng (itemsJson) của báo giá/đơn hàng: [{ productId, code, name, unit, qty, price, discountPct, vatPct }].
model Quote {
  id            String    @id @default(cuid())
  workspaceId   String
  number        String
  recordId      String? // giao dịch
  contactId     String? // khách
  customerName  String    @default("")
  customerPhone String    @default("")
  customerEmail String    @default("")
  title         String    @default("")
  // draft | pending (chờ duyệt) | approved | sent | accepted | rejected | expired
  status        String    @default("draft")
  itemsJson     String    @default("[]")
  discount      Float     @default(0) // chiết khấu cả đơn (tiền)
  subtotal      Float     @default(0)
  vatTotal      Float     @default(0)
  total         Float     @default(0)
  validUntil    DateTime?
  note          String    @default("")
  terms         String    @default("")
  createdBy     String    @default("")
  approvedBy    String    @default("")
  approvedAt    DateTime?
  publicToken   String    @unique @default(cuid())
  viewedAt      DateTime?
  acceptedAt    DateTime?
  acceptedName  String    @default("")
  rejectReason  String    @default("")
  orderId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Order {
  id            String     @id @default(cuid())
  workspaceId   String
  number        String
  recordId      String?
  contactId     String?
  quoteId       String?
  customerName  String     @default("")
  customerPhone String     @default("")
  // new | confirmed | shipping | done | cancelled
  status        String     @default("new")
  itemsJson     String     @default("[]")
  discount      Float      @default(0)
  subtotal      Float      @default(0)
  vatTotal      Float      @default(0)
  total         Float      @default(0)
  paid          Float      @default(0)
  dueAt         DateTime? // hạn thanh toán phần còn lại
  note          String     @default("")
  createdBy     String     @default("")
  // Giao hàng & kênh bán
  shipName      String     @default("")
  shipPhone     String     @default("")
  shipAddress   String     @default("")
  shipProvince  String     @default("")
  shipDistrict  String     @default("")
  shipWard      String     @default("")
  salesChannel  String     @default("") // "" | inbox | shopee | tiktok | ...
  externalId    String     @default("")
  payCode       String     @default("") // mã nội dung chuyển khoản để tự đối soát (vd. DH2026004)
  pointsAwarded Int        @default(0)
  voucherCode   String     @default("")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments      Payment[]
  bankTxns      BankTxn[]
  einvoices     EInvoice[]
  shipments     Shipment[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, payCode])
}

model Payment {
  id          String    @id @default(cuid())
  workspaceId String
  orderId     String
  amount      Float
  method      String    @default("transfer") // cash | transfer | card | other
  paidAt      DateTime  @default(now())
  note        String    @default("")
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([workspaceId, paidAt])
}

model Contract {
  id           String    @id @default(cuid())
  workspaceId  String
  number       String
  recordId     String?
  contactId    String?
  orderId      String?
  title        String
  customerName String    @default("")
  value        Float     @default(0)
  // draft | active | expired | cancelled
  status       String    @default("draft")
  signedAt     DateTime?
  startAt      DateTime?
  endAt        DateTime?
  remindDays   Int       @default(30)
  remindedAt   DateTime?
  fileUrl      String    @default("")
  note         String    @default("")
  createdBy    String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, number])
  @@index([workspaceId, endAt])
}

// ---------- Đợt 2: chăm sóc sau bán ----------
model Ticket {
  id          String          @id @default(cuid())
  workspaceId String
  number      String
  recordId    String? // khách
  subject     String
  body        String          @default("")
  channel     String          @default("manual") // manual | inbox | call | form | email
  priority    String          @default("normal") // low | normal | high | urgent
  status      String          @default("open") // open | pending | resolved | closed
  assignee    String          @default("")
  teamId      String?
  category    String          @default("")
  dueAt       DateTime?
  escalatedAt DateTime?
  resolvedAt  DateTime?
  csat        Int?
  csatComment String          @default("")
  csatToken   String          @unique @default(cuid())
  createdBy   String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, resolvedAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  author    String
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Sổ điểm thưởng: cộng/trừ điểm của một khách (recordId ở bảng contacts).
model LoyaltyTxn {
  id          String    @id @default(cuid())
  workspaceId String
  recordId    String
  points      Int
  reason      String    @default("")
  orderId     String?
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, recordId])
}

model Warranty {
  id           String    @id @default(cuid())
  workspaceId  String
  recordId     String?
  productId    String?
  orderId      String?
  productName  String
  serial       String    @default("")
  customerName String    @default("")
  phone        String    @default("")
  startAt      DateTime
  endAt        DateTime
  status       String    @default("active") // active | claimed | expired | void
  note         String    @default("")
  remindedAt   DateTime?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, phone])
  @@index([workspaceId, endAt])
}

// Nhóm khách động = bộ lọc đã lưu (filtersJson cùng định dạng Lọc nâng cao của bảng).
model Segment {
  id          String    @id @default(cuid())
  workspaceId String
  objectKey   String    @default("contacts")
  name        String
  filtersJson String    @default("[]")
  mode        String    @default("and")
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ---------- Đợt 3: marketing ----------
model Broadcast {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  channel     String // email | zns | sms | zalo
  segmentId   String?
  subject     String    @default("")
  body        String    @default("")
  templateId  String    @default("") // ZNS
  scheduledAt DateTime?
  status      String    @default("draft") // draft | scheduled | sending | done | cancelled
  total       Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  skipped     Int       @default(0)
  opened      Int       @default(0)
  clicked     Int       @default(0)
  createdBy   String    @default("")
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Địa chỉ đã huỷ nhận tin (email, số điện thoại) theo kênh.
model Unsubscribe {
  workspaceId String
  channel     String
  address     String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, channel, address])
}

model LandingPage {
  id          String    @id @default(cuid())
  workspaceId String
  slug        String    @unique
  title       String
  blocksJson  String    @default("[]")
  theme       String    @default("blue")
  published   Boolean   @default(false)
  views       Int       @default(0)
  conversions Int       @default(0)
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ---------- Đợt 4: quản trị ----------
// Chỉ tiêu theo tháng: period "2026-11"; who = tên người, "" = cả công ty.
model KpiTarget {
  id          String    @id @default(cuid())
  workspaceId String
  period      String
  who         String    @default("")
  metric      String // revenue | won_deals | new_contacts | calls | win_rate | tickets_resolved
  target      Float
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period, who, metric])
}

model Post {
  id            String        @id @default(cuid())
  workspaceId   String
  author        String
  body          String
  kind          String        @default("post") // post | announcement | win
  channel       String        @default("chung")
  pinned        Boolean       @default(false)
  reactionsJson String        @default("{}") // { "👍": ["Lan", "Minh"] }
  createdAt     DateTime      @default(now())
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comments      PostComment[]

  @@index([workspaceId, createdAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  author    String
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// Đăng ký nhận thông báo đẩy (Web Push) của từng trình duyệt.
model PushSub {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  endpoint    String    @unique
  p256dh      String
  auth        String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ---------- Bizfly đợt A: chân dung 360° ----------
// Nhật ký ghép trùng: giữ bản ghi gộp (survivor) và ảnh chụp các bản bị gộp để tra cứu.
model MergeLog {
  id           String    @id @default(cuid())
  workspaceId  String
  objectKey    String    @default("contacts")
  survivorId   String
  mergedIds    String // JSON string[]
  snapshotJson String    @default("[]") // dữ liệu các bản bị gộp trước khi gộp
  movedJson    String    @default("{}") // { orders: 2, tickets: 1, ... }
  by           String    @default("")
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ---------- Bizfly đợt B: khảo sát, voucher ----------
model Survey {
  id            String           @id @default(cuid())
  workspaceId   String
  name          String
  kind          String           @default("nps") // nps | csat | custom
  questionsJson String           @default("[]") // [{ id, type: nps|rating|choice|multi|text, label, options?, required? }]
  thankYou      String           @default("Cảm ơn bạn đã góp ý!")
  active        Boolean          @default(true)
  publicKey     String           @unique @default(cuid())
  createdBy     String           @default("")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  responses     SurveyResponse[]
}

// Một lời mời / một câu trả lời. token dùng cho link cá nhân hoá; submittedAt null = đã gửi chưa trả lời.
model SurveyResponse {
  id          String    @id @default(cuid())
  workspaceId String
  surveyId    String
  recordId    String?
  ticketId    String?
  token       String    @unique @default(cuid())
  channel     String    @default("link") // link | email | sms | zns | zalo
  answersJson String    @default("{}")
  nps         Int?
  rating      Int?
  comment     String    @default("")
  sentAt      DateTime  @default(now())
  submittedAt DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  survey      Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([workspaceId, surveyId])
  @@index([workspaceId, recordId])
  @@index([workspaceId, submittedAt])
}

model VoucherCampaign {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String    @default("DNA")
  kind        String    @default("percent") // percent | amount
  value       Float
  maxDiscount Float     @default(0) // trần giảm cho loại %; 0 = không trần
  minOrder    Float     @default(0)
  validDays   Int       @default(30)
  perCustomer Int       @default(1)
  active      Boolean   @default(true)
  note        String    @default("")
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vouchers    Voucher[]
}

model Voucher {
  id          String          @id @default(cuid())
  workspaceId String
  campaignId  String
  code        String
  recordId    String?
  status      String          @default("issued") // issued | used | expired | void
  reason      String          @default("") // vd. "Sinh nhật", "Thủ công", "Tự động hoá"
  expiresAt   DateTime
  usedAt      DateTime?
  usedOrderId String?
  discount    Float           @default(0) // số tiền thực giảm khi dùng
  sentVia     String          @default("")
  createdAt   DateTime        @default(now())
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign    VoucherCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
  @@index([workspaceId, recordId])
}

// ---------- Bizfly đợt C: phòng ban, đánh giá ----------
model Team {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  leader      String    @default("") // tên người
  membersJson String    @default("[]") // string[] tên người
  color       String    @default("#579bfc")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// Phiếu đánh giá định kỳ một nhân viên: period "2026-11"; scoresJson { criterionId: điểm 0–100 }.
model PerfReview {
  id          String    @id @default(cuid())
  workspaceId String
  period      String
  who         String
  scoresJson  String    @default("{}")
  total       Float     @default(0)
  comment     String    @default("")
  reviewer    String    @default("")
  status      String    @default("draft") // draft | done
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period, who])
}

// ---------- Bizfly đợt D: dạng xem đã lưu ----------
// stateJson: { view, hidden[], order[], widths{}, filters[], mode, groupBy, sort, colSort, density, colorRules[] }
model BoardView {
  id          String    @id @default(cuid())
  workspaceId String
  objectKey   String
  name        String
  ownerId     String
  ownerName   String    @default("")
  shared      Boolean   @default(false)
  isDefault   Boolean   @default(false)
  stateJson   String    @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, objectKey])
}

// ---------- Pancake: fanpage, bài viết, trả lời nhanh ----------
// Một fanpage (hoặc Zalo OA về sau) đã kết nối. token là Page Access Token — bí mật, không trả về trình duyệt.
model FbPage {
  id           String    @id @default(cuid())
  workspaceId  String
  platform     String    @default("facebook") // facebook | instagram
  pageId       String
  name         String    @default("")
  avatar       String    @default("")
  token        String    @default("")
  active       Boolean   @default(true)
  settingsJson String    @default("{}") // { autoHidePhone, autoHideAll, autoLike, signature, autoMarkRead, ... }
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, pageId])
}

model FbPost {
  id            String    @id @default(cuid())
  workspaceId   String
  pageId        String
  postId        String
  message       String    @default("")
  image         String    @default("")
  permalink     String    @default("")
  kind          String    @default("post") // post | photo | video | live
  live          Boolean   @default(false)
  postedAt      DateTime  @default(now())
  commentsCount Int       @default(0)
  phonesCount   Int       @default(0)
  topic         String    @default("")
  settingsJson  String    @default("{}") // { autoHidePhone, autoHideAll, skip, replyComment, replyInbox, productIds }
  mergeKey      String    @default("") // gộp nhiều bài (livestream) để xem chung
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, postId])
  @@index([workspaceId, postedAt])
}

// Mẫu trả lời nhanh: gõ /shortcut khi chat. content có biến {ten}, {nhan_vien}, {trang}...
model QuickReply {
  id              String    @id @default(cuid())
  workspaceId     String
  shortcut        String    @default("")
  topic           String    @default("")
  content         String
  attachmentsJson String    @default("[]")
  sort            Int       @default(0)
  uses            Int       @default(0)
  createdBy       String    @default("")
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, shortcut])
}

// ---------- Thanh toán, hoá đơn, vận chuyển ----------
// Giao dịch ngân hàng nhận qua webhook (Casso/SePay…) để tự đối soát với đơn.
model BankTxn {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String // casso | sepay | manual
  externalId  String
  amount      Float
  content     String    @default("")
  accountNo   String    @default("")
  at          DateTime  @default(now())
  orderId     String?
  paymentId   String?
  status      String    @default("unmatched") // matched | unmatched | ignored
  rawJson     String    @default("{}")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, status])
}

model EInvoice {
  id          String    @id @default(cuid())
  workspaceId String
  orderId     String
  provider    String // misa | viettel | vnpt | demo
  status      String    @default("draft") // draft | issued | failed | cancelled
  series      String    @default("")
  number      String    @default("")
  lookupCode  String    @default("")
  pdfUrl      String    @default("")
  buyerJson   String    @default("{}") // tên, MST, địa chỉ, email người mua
  total       Float     @default(0)
  error       String    @default("")
  rawJson     String    @default("{}")
  issuedAt    DateTime?
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([workspaceId, orderId])
}

model Shipment {
  id           String    @id @default(cuid())
  workspaceId  String
  orderId      String
  carrier      String // ghn | ghtk | vtp | manual | demo
  trackingCode String    @default("")
  status       String    @default("created") // created | picking | delivering | delivered | returned | cancelled | failed
  fee          Float     @default(0)
  cod          Float     @default(0)
  eventsJson   String    @default("[]") // [{ at, status, text }]
  error        String    @default("")
  rawJson      String    @default("{}")
  createdBy    String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([workspaceId, orderId])
  @@index([workspaceId, trackingCode])
}

// ---------- AI: kho kiến thức ----------
model KbDoc {
  id          String    @id @default(cuid())
  workspaceId String
  kind        String    @default("faq") // faq | doc | policy | product | conversation
  title       String
  content     String
  tagsJson    String    @default("[]")
  source      String    @default("") // manual | upload | inbox:<convId> | product:<id>
  active      Boolean   @default(true)
  uses        Int       @default(0)
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
}

// ---------- Kho, bảng giá, mẫu in ----------
model StockMove {
  id          String    @id @default(cuid())
  workspaceId String
  productId   String
  qty         Float // dương = nhập, âm = xuất
  kind        String // in | out | adjust | order | return
  orderId     String?
  note        String    @default("")
  balance     Float     @default(0) // tồn sau khi ghi
  by          String    @default("")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, productId, createdAt])
}

// Bảng giá theo hạng thành viên: tier = tên hạng; productId hoặc category (rỗng = mọi sản phẩm).
model PriceRule {
  id          String    @id @default(cuid())
  workspaceId String
  tier        String
  productId   String    @default("")
  category    String    @default("")
  discountPct Float     @default(0)
  price       Float? // giá cố định (ưu tiên hơn %)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, tier])
}

model PrintTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  docType     String // quote | order | contract | invoice
  name        String
  layoutJson  String    @default("[]") // danh sách khối kéo thả
  isDefault   Boolean   @default(false)
  createdBy   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, docType])
}

// ---------- Chat nội bộ, báo cáo ----------
model ChatThread {
  id          String        @id @default(cuid())
  workspaceId String
  kind        String        @default("dm") // dm | group
  name        String        @default("")
  membersJson String        @default("[]") // userId[]
  lastText    String        @default("")
  lastAt      DateTime      @default(now())
  createdBy   String        @default("")
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@index([workspaceId, lastAt])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  userId     String
  body       String
  refJson    String     @default("{}") // đính kèm liên kết tới khách/đơn/việc
  readByJson String     @default("[]")
  createdAt  DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model Report {
  id             String    @id @default(cuid())
  workspaceId    String
  name           String
  configJson     String    @default("{}") // nguồn, nhóm theo, chỉ số, bộ lọc, kiểu biểu đồ
  scheduleJson   String    @default("{}") // { freq: off|daily|weekly|monthly, hour, weekday, day }
  recipientsJson String    @default("[]") // email
  shared         Boolean   @default(false)
  lastSentAt     DateTime?
  createdBy      String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ---------- Kênh khác: WhatsApp, Shopee, TikTok Shop (Instagram dùng FbPage platform "instagram") ----------
model ChannelAccount {
  id              String    @id @default(cuid())
  workspaceId     String
  platform        String // whatsapp | shopee | tiktok
  accountId       String
  name            String    @default("")
  credentialsJson String    @default("{}") // bí mật: không trả về trình duyệt
  settingsJson    String    @default("{}")
  active          Boolean   @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, accountId])
}
